# Variables de entorno
.env
.env.respaldo

# Bases SQLite (la de trabajo, la demo, WAL/SHM)
*.db
*.db-wal
*.db-shm
*.sqlite3

# Datos en runtime (el binario crea storage/ al arrancar; nada de aquí se versiona)
storage/

# Restos de runtime del sistema Python anterior (por si quedan en disco)
.nicegui/
vendor/
.cache_secop/
paquetes/
*.tar

# Licencia del cliente. Cada instalación tiene la suya y ninguna va al repo.
licencia.quipu

# Rust
rust/target/

# Angular
angular/node_modules/
angular/dist/
angular/.angular/

# La interfaz compilada se EMPOTRA en el binario, no se versiona: es un artefacto
# de construcción, y versionarlo garantiza que un día el binario viaje con una
# interfaz distinta de la del código que lo acompaña.
rust/siger-api/estaticos/*
!rust/siger-api/estaticos/.gitkeep

# Base de demostración: se regenera con `python rust/sembrar_demo.py`.
rust/demo/

# Datos sensibles (archivados) y hojas de cálculo sueltas
archivado_datos_sensibles/
*.xlsx
!plantillas/*.xlsx

# Transcripciones de sesión (no son parte del producto)
conversaciones/

# Restos de Python (por si quedara caché tras el cutover)
__pycache__/
*.py[cod]
.venv/

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
