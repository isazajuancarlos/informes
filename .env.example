# === Perfil de despliegue =====================================================
# cloud     : SaaS que hospedamos (PostgreSQL, con internet).  [por defecto]
# onprem    : el cliente lo corre en su servidor/LAN (su PostgreSQL, sin internet).
# standalone: una sola máquina, SQLite, sin base de datos que administrar, offline.
# El mismo código y la misma imagen sirven a los tres. Ver DESPLIEGUE.md.
DEPLOYMENT_PROFILE=cloud

# OFFLINE: no asumir internet (onprem/standalone lo activan solos; override aquí).
# OFFLINE=true

# Database Configuration
# Si DEPLOYMENT_PROFILE=standalone y no defines DATABASE_URL, usa SQLite en
# storage/informes.db automáticamente. Para cloud/onprem, PostgreSQL:
DATABASE_URL=postgresql://postgres:admin@localhost/informes

# Contraseña de la BD (la usan los docker-compose para PostgreSQL en onprem)
DB_PASSWORD=cambia_esta_clave

# Application Base URL (used in email links — change to your public URL in production)
APP_BASE_URL=http://localhost:8003

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=tu_correo@gmail.com
SENDER_PASSWORD=tu_password_app

# Application Security
STORAGE_SECRET=SECRET_KEY_FINAL_V6
SESSION_TIMEOUT_MINUTES=60

# Scheduler Configuration
ENABLE_AUTO_SCHEDULER=true
SCHEDULER_HOUR=0
SCHEDULER_MINUTE=0

# Retroactivity Configuration (days to look back for task generation)
MAX_RETROACTIVE_DAYS=730

# File Upload Configuration
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf,.xlsx,.docx,.zip

# Backup Configuration
BACKUP_PATH=storage/backups

# --- Firma post-cuántica de entregas (OPCIONAL) -------------------------------
# Requiere: pip install -r requirements-firma.txt
# Si no se configura, las entregas se registran igual y quedan SIN firma. Eso es
# un estado legítimo, no un error: la interfaz lo muestra como "sin firma" y no
# como "firma inválida".
#
# Perfil de custodia de la clave privada: entorno (por defecto) | hsm
QUIPU_CUSTODIA=entorno

# --- Perfil `entorno` ---------------------------------------------------------
# Genera el par una sola vez:
#   python -c "from app.services.signing_service import generar_claves; \
#              vk, sk = generar_claves(); print('VK=', vk); print('SK=', sk)"
# Límite que hay que asumir: quien pueda leer las variables de entorno del
# proceso tiene la clave, y con ella puede firmar entregas que nunca ocurrieron.
QUIPU_VERIFYING_KEY=
QUIPU_SIGNING_KEY=

# --- Perfil `hsm` (la clave privada NUNCA entra al proceso) --------------------
# La clave pública se lee del propio dispositivo: no se configura aquí, y así no
# puede desincronizarse de la privada.
# QUIPU_PKCS11_MODULE=/usr/lib64/pkcs11/libXXX_pkcs11.so
# QUIPU_PKCS11_PIN=
# QUIPU_PKCS11_ED25519=etiqueta-de-la-clave-ed25519
# QUIPU_PKCS11_MLDSA=etiqueta-de-la-clave-mldsa

# --- Licencia offline (opcional) ----------------------------------------------
# Archivo firmado por EL LICENCIANTE que la app verifica en local, sin red.
# NUNCA bloquea: sin licencia, vencida o alterada, el sistema opera igual y solo
# muestra un aviso. El remedio ante el exceso es contractual, no técnico.
INFORMES_LICENCIA=licencia.quipu
# Clave PÚBLICA del licenciante (64 hex). Sin ella no se puede verificar y el
# aviso lo dice; no se asume que la licencia sea válida.
INFORMES_LICENCIA_PUBKEY=
