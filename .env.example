# Configuración del binario Rust (siger-api). El binario NO arranca si falta un
# secreto; no hay valores por defecto peligrosos. Ver DESPLIEGUE.md.

# === OBLIGATORIO ==============================================================
# Secreto de sesión (>= 32 bytes). Sin él el binario no arranca —a propósito: un
# secreto con valor conocido es el mismo para todas las instalaciones.
#   Genéralo con:  siger-api generar-secreto
SIGER_SECRETO_SESION=

# === Base de datos y servidor ================================================
# SQLite por defecto (perfil de una sola máquina, el que se entrega instalado).
DATABASE_URL=sqlite://siger.db
PORT=8003
PAIS_ISO=CO
SIGER_MINUTOS_SESION=60

# === Archivos de las entregas ================================================
SIGER_DIR_ENTREGAS=storage/entregas
SIGER_MAX_MB=50
# Extensiones admitidas (tope general; cada informe puede exigir menos). Vacío = cualquiera.
SIGER_EXTENSIONES=.pdf,.xlsx,.docx,.zip,.csv,.xml

# === Firma post-cuántica de entregas (OPCIONAL) ==============================
# Sin claves, la entrega se registra igual y queda SIN firma: es un estado
# legítimo, no un error. Genera el par con:  siger-api generar-claves-firma
QUIPU_SIGNING_KEY=
QUIPU_VERIFYING_KEY=

# === Alertas por correo (DORMIDAS por defecto) ===============================
# Enciéndelas con ALERTAS_ACTIVAS=true; si se encienden, host y remitente son
# obligatorios (el binario falla al arrancar si están a medias: una alerta sin
# servidor de correo es una alerta que no llega).
# ALERTAS_ACTIVAS=true
# SMTP_HOST=smtp.zoho.com
# SMTP_DESDE=SIGER <alertas@tu-dominio>
# SMTP_TLS=starttls          # starttls (587) | directo (465) | ninguno (solo pruebas)
# SMTP_PUERTO=587
# SMTP_USUARIO=
# SMTP_CLAVE=
# ALERTAS_DIAS_PROXIMIDAD=3
# A quién se avisa (por defecto, a los tres):
# ALERTAS_A_OPERADOR=true
# ALERTAS_A_SUPERVISION=true
# ALERTAS_A_TERCERO=true

# === Licencia offline ========================================================
# NOTA: en el port a Rust la emisión/verificación de la licencia offline TODAVÍA
# NO está portada (era una función del app Python, ahora retirado). Cuando se
# porte, aquí irán INFORMES_LICENCIA e INFORMES_LICENCIA_PUBKEY. La licencia
# NUNCA bloquea nada: su ausencia no puede causar el incumplimiento del cliente.
