; Regenera la base de la demostración. Lo dispara el timer cada noche.
;
; Por qué existe: la demostración es pública y escribible. Sin esto, a la semana
; enseña lo que hayan dejado los visitantes en vez de lo que queremos enseñar.
; Y las fechas de la semilla se calculan desde HOY: regenerarla es también lo que
; impide que a las dos semanas todo aparezca vencido.
[Unit]
Description=SIGER demo — regenerar los datos de demostración
After=network.target

[Service]
Type=oneshot

; SIN `User=siger`, a propósito, y no por descuido: parar y arrancar otro
; servicio es cosa de root, y con `User=siger` los dos `systemctl` de aquí abajo
; fallaban con «Access denied» — la resiembra habría quedado en verde el primer
; día y muerta desde el segundo, que es la clase de fallo que no se mira.
;
; La siembra en sí NO corre como root: `runuser` la baja a `siger`, que es quien
; tiene que ser dueño de la base y del almacén para que el servicio pueda
; escribirlos después.
ExecStart=/usr/bin/systemctl stop siger-demo.service
; `--limpiar` borra la base y el almacén, NO la carpeta: aquí dentro viven
; también el binario y este guion.
ExecStart=/usr/bin/runuser -u siger -- /usr/bin/python3 /opt/siger-demo/sembrar_demo.py --ruta /opt/siger-demo --binario /opt/siger-demo/siger-api --limpiar
ExecStart=/usr/bin/systemctl start siger-demo.service
